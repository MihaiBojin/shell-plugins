# Branch from the default branch, brought up to date first.
emulate -L zsh

local branch head base='' pretty='' remote

while (( $# )); do
  case $1 in
    -h|--help)
      print -ru2 -- 'gnb NAME          fetch, then branch NAME off the default branch and check it out'
      print -ru2 -- ''
      print -ru2 -- 'The base is <remote>/<default branch> as it stands after the fetch, so'
      print -ru2 -- 'the branch starts from what the server has rather than from the local'
      print -ru2 -- 'copy. Nothing is rebased afterwards: a branch created there is already'
      print -ru2 -- 'on top of it.'
      return 0
      ;;
    *) break ;;
  esac
done

if (( $# != 1 )); then
  _git_alias_say err "usage: gnb NAME"
  return 2
fi
branch=$1

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  _git_alias_say err "not inside a git repository"
  return 1
fi

if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
  _git_alias_say err "$branch is not a valid branch name"
  return 2
fi

if git show-ref --verify --quiet "refs/heads/$branch"; then
  _git_alias_say err "$branch is already a branch — gb $branch checks it out"
  return 1
fi

# A failed fetch is not fatal. An offline machine still gets a branch, off
# whatever it last saw, and the line at the end names the commit it got.
git fetch --all || _git_alias_say warn "could not fetch — branching from what is already here"

head=$(_git_alias_main_branch)

# Full refs, never `origin/main`: git resolves a bare name as a tag first, so a
# repository holding a tag of that name would branch from the tag. origin
# before upstream, and the remote copy before the local one, which is the order
# _git_alias_main_branch itself asks in.
for remote in origin upstream; do
  if git show-ref --verify --quiet "refs/remotes/$remote/$head"; then
    base="refs/remotes/$remote/$head"
    pretty="$remote/$head"
    break
  fi
done
if [[ -z $base ]]; then
  if git show-ref --verify --quiet "refs/heads/$head"; then
    base="refs/heads/$head"
    pretty="$head"
  else
    _git_alias_say err "cannot tell which branch is the default — record it with: git remote set-head origin --auto"
    return 1
  fi
fi

# --no-track: a branch off origin/main would otherwise take the default branch
# as its upstream, and git pull would merge it back in.
git checkout --no-track -b "$branch" "$base" || return 1

_git_alias_say info "$branch from $pretty at $(git rev-parse --short "$base")"
