# Say what deleting $1 would cost.
#
# Prints one line of reasoning either way. The exit status is the verdict: 0 the
# commits survive somewhere else, 1 this name is the only handle on them.
emulate -L zsh

local branch=$1 head base tree head_tree synth verdict sha twin
head=$(_git_alias_main_branch)

if git merge-base --is-ancestor "refs/heads/$branch" "refs/heads/$head" 2>/dev/null; then
  print -r -- "merged into $head"
  return 0
fi

# Most branches end in a squash, which rewrites their commits into one, so git
# sees a branch whose commits appear nowhere upstream — the same shape as a
# branch nobody ever merged. Ask a different question: replay the tree as a
# single commit on the merge base and let `git cherry` compare content rather
# than history, which is what a squash preserves.
base=$(git merge-base "refs/heads/$head" "refs/heads/$branch" 2>/dev/null)
tree=$(git rev-parse "refs/heads/${branch}^{tree}" 2>/dev/null)
if [[ -n $base && -n $tree ]]; then
  # commit-tree fails outright when user.email is unset, so the identity is
  # pinned. Nothing references the commit; the next gc collects it.
  synth=$(
    GIT_AUTHOR_NAME=git-alias GIT_AUTHOR_EMAIL=git-alias@localhost GIT_AUTHOR_DATE='@0 +0000' \
    GIT_COMMITTER_NAME=git-alias GIT_COMMITTER_EMAIL=git-alias@localhost GIT_COMMITTER_DATE='@0 +0000' \
    git commit-tree "$tree" -p "$base" -m _ 2>/dev/null
  )
  if [[ -n $synth ]]; then
    # A leading '-' means the patch is already upstream.
    verdict=$(git cherry "refs/heads/$head" "$synth" 2>/dev/null)
    if [[ $verdict == '-'* ]]; then
      print -r -- "squash-merged into $head"
      return 0
    fi
  fi

  # A branch that leaves the head branch's tree exactly as it found it has
  # nothing left to contribute, whatever its history says.
  head_tree=$(git rev-parse "refs/heads/${head}^{tree}" 2>/dev/null)
  if [[ -n $head_tree && $tree == $head_tree ]]; then
    print -r -- "leaves ${head}'s tree exactly as it found it"
    return 0
  fi
fi

# Another ref at the same commit: the name goes, the commits stay reachable
# under the other one. A pushed branch usually lands here, through its
# remote-tracking ref.
sha=$(git rev-parse --verify --quiet "refs/heads/$branch")
if [[ -n $sha ]]; then
  for twin in ${(f)"$(git for-each-ref --format='%(refname:short)' --points-at "$sha" refs/heads refs/remotes)"}; do
    [[ $twin == $branch ]] && continue
    print -r -- "same commit as $twin"
    return 0
  done
fi

print -r -- "not in $head: no merge, no squash, no other ref at its commit"
return 1
