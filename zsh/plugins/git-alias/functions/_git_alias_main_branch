# What this repository calls its default branch.
#
# Used by gcm and gmom. `main` and `master` are both common enough that
# guessing is wrong often enough to notice, so ask the repository first: git
# records the answer in <remote>/HEAD at clone time, from what the server
# advertised.
#
# Deliberately not shared with the git-worktree plugin's _gw_default_branch,
# which does the same job more thoroughly and can go to the network. Each
# plugin here works when it is the only one installed.
emulate -L zsh

local ref remote branch
git rev-parse --git-dir >/dev/null 2>&1 || return 1

for remote in origin upstream; do
  ref=$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null) || continue
  print -r -- "${ref#$remote/}"
  return 0
done

for branch in main trunk master; do
  if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
    print -r -- "$branch"
    return 0
  fi
done

# Nothing said so. `main` is the likelier guess and the caller sees it fail.
print -r -- main
return 1
