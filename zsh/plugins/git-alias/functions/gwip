# Commit everything as a work in progress.
#
# --no-gpg-sign because a commit that exists to be thrown away should not stop
# to ask for a passphrase, and [skip ci] because it is not worth a build.
# gunwip takes the last one back; gunwipall takes a whole run.
emulate -L zsh

git add -A || return 1

# Only when there is something to remove: `git rm` with no pathspec is a fatal
# error, and hiding it behind 2>/dev/null hides real ones too. The list is an
# array, so a filename with a space in it stays one path.
local -a deleted
deleted=( ${(f)"$(git ls-files --deleted)"} )
(( $#deleted )) && { git rm --quiet -- $deleted || return 1 }

git commit --no-verify --no-gpg-sign --message "--wip-- [skip ci]"
