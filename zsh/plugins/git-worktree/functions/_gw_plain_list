# This repository's worktrees, one per line, without colour or padding:
#
#     <mark> \t <branch> \t <path>
#
# <mark> is `*` for the worktree you are standing in and a space otherwise;
# <branch> is `(bare)`, `(detached)` or `?` when there is no branch. The path is
# absolute and unshortened, so `gwl --list | cut -f3` feeds `cd` directly — which
# is the whole reason this exists next to _gw_list, whose columns are shortened
# and coloured for a person reading a picker.
emulate -L zsh

local -a recs fields
local rec p br flags cwd mark

_gw_in_repo || return 1

recs=( ${(0)"$(_gw_records)"} )
(( $#recs )) || return 1

cwd=${PWD:A}
for rec in $recs; do
  fields=( "${(@ps:\x1f:)rec}" )
  p=$fields[1]
  br=$fields[3]
  flags=$fields[4]
  if [[ -z $br ]]; then
    case $flags in
      *bare*)     br='(bare)' ;;
      *detached*) br='(detached)' ;;
      *)          br='?' ;;
    esac
  fi
  [[ $cwd == ${p:A} || $cwd == ${p:A}/* ]] && mark='*' || mark=' '
  print -r -- "$mark"$'\t'"$br"$'\t'"$p"
done
