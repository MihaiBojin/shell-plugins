# The full ref new worktrees are based on when no BASE was given, e.g.
# refs/remotes/origin/main. Full, never `origin/main`: the answer is used as a
# revision, and a bare name is resolved as a tag first — see _gw_full_ref.
#
#   $1 remote   $2 may we use the network   $3 may we ask the user
#   $4 the repository to ask (default: $PWD)
#
# <remote>/HEAD is the repository's own answer — git records it at clone time
# from what the server advertises — so it is what tells main from master
# without guessing. It is missing when the remote was added by hand rather than
# cloned, and stale after the default branch is renamed; `remote set-head
# --auto` re-asks the server and caches the answer, so we only pay for it once.
# Guessing is the last resort, and says so when the guess is a coin flip.
emulate -L zsh
local remote=$1 online=${2:-0} interactive=${3:-0} repo=${4:-$PWD} ref b chosen
local -a candidates

# 0. An answer somebody wrote down beats anything derived.
#    git-worktree-plugin.headBranch is the shared key: the companion `origin`
#    plugin reads the same one, so both tools agree on the head branch.
local stated
stated=$(git -C "$repo" config --get git-worktree-plugin.headBranch 2>/dev/null) || stated=''
if [[ -n $stated ]]; then
  if [[ -n $remote ]] && git -C "$repo" show-ref --verify --quiet "refs/remotes/$remote/$stated" 2>/dev/null; then
    _gw_full_ref "$remote/$stated" "$repo"
  else
    _gw_full_ref "$stated" "$repo"
  fi
  return 0
fi

# 1. The repository's own answer, refreshed from the server if allowed.
if [[ -n $remote ]]; then
  ref=$(_gw_remote_head "$remote" "$repo") && { _gw_full_ref "$ref" "$repo"; return 0 }
  # set-head can only point at a remote-tracking ref, so don't spend a round
  # trip (or print its error) when the repository has none.
  if (( online )) &&
     [[ -n $(git -C "$repo" for-each-ref --count=1 --format='%(refname)' "refs/remotes/$remote" 2>/dev/null) ]] &&
     _gw_run "asking $remote for its default branch" \
       git -C "$repo" remote set-head "$remote" --auto; then
    ref=$(_gw_remote_head "$remote" "$repo") && { _gw_full_ref "$ref" "$repo"; return 0 }
  fi
fi

# 2. Conventional names — decisive only when exactly one of them exists.
#    Remote-tracking first, then local heads: a repository can have a remote
#    and still no refs/remotes at all — a bare clone keeps its branches in
#    refs/heads, and a remote added by hand has never been fetched.
if [[ -n $remote ]]; then
  for b in main master trunk; do
    git -C "$repo" show-ref --verify --quiet "refs/remotes/$remote/$b" 2>/dev/null && candidates+=( "$remote/$b" )
  done
fi
(( $#candidates )) || for b in main master trunk; do
  git -C "$repo" show-ref --verify --quiet "refs/heads/$b" 2>/dev/null && candidates+=( "$b" )
done
(( $#candidates == 1 )) && { _gw_full_ref "${candidates[1]}" "$repo"; return 0 }

# 3. Still ambiguous. Ask rather than guess, then write the answer to
#    <remote>/HEAD, where git itself — and every other tool — will find it.
if (( interactive )); then
  local -a extra
  [[ -n $remote ]] &&
    extra=( ${(f)"$(git -C "$repo" for-each-ref --format='%(refname:strip=2)' --sort=-committerdate --count=25 "refs/remotes/$remote" 2>/dev/null)"} )
  (( $#extra )) ||
    extra=( ${(f)"$(git -C "$repo" for-each-ref --format='%(refname:strip=2)' --sort=-committerdate --count=25 refs/heads 2>/dev/null)"} )
  extra=( ${extra:#*HEAD} )
  for b in $extra; do
    (( ${candidates[(Ie)$b]} )) || candidates+=( "$b" )
  done
  (( $#candidates )) || return 1

  if (( $#candidates == 1 )); then
    chosen=${candidates[1]}
  else
    chosen=$(_gw_choose \
      "${remote:+$remote/HEAD is not set — }which branch should new worktrees be based on?" \
      "${candidates[@]}") || return 1
  fi

  if [[ -n $remote && $chosen == $remote/* ]] &&
     git -C "$repo" symbolic-ref "refs/remotes/$remote/HEAD" "refs/remotes/$chosen" 2>/dev/null; then
    _gw_info "recorded $remote/HEAD -> $chosen  (undo: git -C "$repo" symbolic-ref -d refs/remotes/$remote/HEAD)"
  fi
  _gw_full_ref "$chosen" "$repo"
  return 0
fi

# 4. Non-interactive: guess, and be honest that it is one.
(( $#candidates )) || return 1
(( $#candidates > 1 )) && _gw_warn \
  "${remote:+$remote/HEAD is unset and }${(j:, :)candidates} all exist — guessing ${candidates[1]}${remote:+; settle it with: git -C "$repo" remote set-head ${(q)remote} --auto}"
_gw_full_ref "${candidates[1]}" "$repo"
