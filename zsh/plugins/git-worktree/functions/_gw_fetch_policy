# The network policy as configured, before any flag overrides it. $1 is the
# answer when nothing says.
#
# git-worktree-plugin.fetch is the shared key: the Fish plugin and the
# companion `origin` CLI read the same one, so a repository answers this
# question once for all three. The zstyle stays and still wins, because it is
# how a person sets a preference for every repository at once, which git config
# can only do through --global.
emulate -L zsh

local answer
zstyle -s ':git-worktree:' fetch answer && { print -r -- "$answer"; return 0 }

answer=$(git config --get git-worktree-plugin.fetch 2>/dev/null)
[[ -n $answer ]] && { print -r -- "$answer"; return 0 }

print -r -- "${1:-always}"
