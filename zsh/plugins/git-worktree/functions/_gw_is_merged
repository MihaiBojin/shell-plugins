# Is branch $1 finished with respect to $2? The one predicate — gwr asks it
# about the branch you named, --all asks it about every branch it walks, and
# they differ in nothing else.
#
#   $1 branch  $2 head ref  $3 head name for messages  $4 may we ask the forge
#   $5 the repository to ask (default: $PWD)
#
# $REPLY is the reason either way, phrased to be read after "branch <name> —":
# on success what makes it finished, on failure what does not. Three ways to
# qualify, in this order: git can see the merge; the *change* is already
# upstream even though git cannot see it (a squash); or the forge says the
# request was merged or closed. Only the third needs the network, and only the
# third can be wrong about work pushed after the merge — hence the count.
emulate -L zsh

local branch=$1 head_ref=$2 head_name=$3 use_forge=$4 repo=${5:-$PWD} why state num
integer unpushed
REPLY=''

if _gw_merged_reason "$branch" "$head_ref" "$repo"; then
  why=$REPLY
  REPLY="$why into $head_name"
  return 0
fi

if (( use_forge )) && _gw_forge_state "$branch"; then
  state=${REPLY%%$'\t'*}
  num=${REPLY##*$'\t'}
  case $state in
    MERGED|CLOSED)
      # No upstream means the answer is unknown, not zero — and gwa makes
      # branches with --no-track, so unknown is the normal case. A request
      # that says "merged" cannot speak for commits nobody has pushed.
      if ! unpushed=$(_gw_unpushed_count "$branch" "$repo"); then
        REPLY="its ${_GW_FORGE_NOUN} is ${state:l}, but the branch has no upstream to have been pushed to"
        return 1
      fi
      if (( unpushed == 1 )); then
        REPLY="its ${_GW_FORGE_NOUN} is ${state:l}, but one commit here is not in it"
        return 1
      elif (( unpushed > 1 )); then
        REPLY="its ${_GW_FORGE_NOUN} is ${state:l}, but $unpushed commits here are not in it"
        return 1
      fi
      REPLY="its ${_GW_FORGE_NOUN} #$num is ${state:l}"
      return 0
      ;;
  esac
fi

REPLY="not merged into $head_name"
return 1
