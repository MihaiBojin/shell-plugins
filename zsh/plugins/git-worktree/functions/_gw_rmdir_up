# Remove $1 and its now-empty parents, stopping below (and keeping) $2. With
# $2 the repository's parent, an emptied .worktrees/<name> goes with it,
# .worktrees included — nothing is left lying beside the repo.
#
# Both paths are resolved with :A rather than :a, symlinks and all. Callers get
# them from different places — a path you typed, and one git printed — and on
# macOS that is /var/... against /private/var/..., which are the same directory
# and do not compare equal.
local d=${1:A} stop=${2:A}
while [[ -d $d && $d == $stop/* ]]; do
  rmdir -- "$d" 2>/dev/null || break
  d=${d:h}
done
