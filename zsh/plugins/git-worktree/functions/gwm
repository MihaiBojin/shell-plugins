# gwm NEW — rename this worktree's branch to NEW and move its checkout to match.
#
# Directory name equals branch name is the invariant every tool writing into
# this root keeps, so renaming a branch is two operations that have to happen
# together: `git branch -m` and `git worktree move`. Doing one without the other
# leaves a worktree whose directory says one thing and whose HEAD says another,
# which is the state gwl and gwr both read wrong.
#
# Three pieces of tidying git does not do on its own: the new parent has to
# exist before `git worktree move` will write into it, the old one is left
# behind empty, and neither is `git worktree move`'s business.
emulate -L zsh

local -a pos
while (( $# )); do
  case $1 in
    -h|--help) _gw_usage; return 0 ;;
    --)        shift; pos+=( "$@" ); break ;;
    -*)        _gw_err "unknown option: $1"; return 2 ;;
    *)         pos+=( "$1" ); shift ;;
  esac
done

local new=${pos[1]}
[[ -n $new ]] || { _gw_err "NEW is required — usage: gwm NEW"; return 2 }
(( $#pos <= 1 )) || { _gw_err "too many arguments — usage: gwm NEW"; return 2 }

_gw_in_repo || { _gw_err "not inside a git repository"; return 1 }
git check-ref-format "refs/heads/$new" 2>/dev/null || {
  _gw_err "invalid branch name: $new"; return 2
}

local main src=''
main=$(_gw_main_worktree) || { _gw_err "cannot locate this repository's main worktree"; return 1 }

local -a recs fields
local rec branch='' flags=''
recs=( ${(0)"$(_gw_records)"} )

# The worktree you are standing in — found by asking which record contains
# $PWD, rather than assuming $PWD is its root — or one you pick. The main
# checkout is neither: git cannot move it, and its directory name is not a
# branch name.
for rec in $recs; do
  fields=( "${(@ps:\x1f:)rec}" )
  [[ ${fields[1]:A} == ${main:A} ]] && continue
  [[ ${PWD:A} == ${fields[1]:A} || ${PWD:A} == ${fields[1]:A}/* ]] || continue
  src=$fields[1]
  break
done
if [[ -z $src ]]; then
  [[ ${PWD:A} == ${main:A} || ${PWD:A} == ${main:A}/* ]] || {
    _gw_err "not inside one of this repository's worktrees"; return 1
  }
  src=$(_gw_pick 'move>' "") || return 1
fi

[[ ${src:A} != ${main:A} ]] || { _gw_err "refusing to move the main worktree: $src"; return 1 }

# What is checked out there, and is it something that can be renamed?
for rec in $recs; do
  fields=( "${(@ps:\x1f:)rec}" )
  [[ ${fields[1]:A} == ${src:A} ]] || continue
  branch=$fields[3] flags=$fields[4]
  break
done

if [[ $flags == *locked* ]]; then
  _gw_err "$src is locked — unlock it first:"
  print -ru2 -- "  ${_GW_DIM}git -C ${(q)main} worktree unlock ${(q)src}${_GW_RESET}"
  return 1
fi
if [[ -z $branch ]]; then
  _gw_err "$src has no branch checked out — there is nothing to rename"
  return 1
fi
if [[ $branch == $new ]]; then
  _gw_err "$branch is already called that"
  return 1
fi
if git show-ref --verify --quiet "refs/heads/$new"; then
  _gw_err "branch '$new' already exists"
  return 1
fi

local dest
dest=$(_gw_dest "$new") || { _gw_err "cannot work out where $new would go"; return 1 }

# The same three collisions gwa refuses, for the same reasons: the destination
# can belong to another repository, can be one of ours already, or can have one
# of our own worktrees nesting above it.
if [[ -e $dest ]]; then
  _gw_err "$dest already exists"
  return 1
fi
local up=${dest:h}
while [[ $up == */* && ! -e $up ]]; do up=${up:h}; done
if [[ -e $up/.git ]] && ! _gw_owns "$up"; then
  _gw_err "$up is a worktree of ${REPLY} — '$new' would nest inside it"
  _gw_err "pick a name that is not a prefix of it, or move that worktree"
  return 1
fi

print -ru2 -- "Rename ${_GW_CYAN}${branch}${_GW_RESET} to ${_GW_CYAN}${new}${_GW_RESET}"
print -ru2 -- "  ${_GW_DIM}${src}${_GW_RESET}"
print -ru2 -- "  ${_GW_DIM}${dest}${_GW_RESET}"
_gw_confirm "Proceed?" || { _gw_info "left alone"; return 1 }

# The branch first: `git worktree move` records the new path, and renaming
# afterwards would leave the two steps recoverable in the wrong order if the
# move failed.
_gw_run "renaming $branch" git -C "$main" branch -m "$branch" "$new" || return 1

mkdir -p -- "${dest:h}" || {
  _gw_err "could not create ${dest:h}"
  _gw_warn "the branch is now $new; its worktree is still at $src"
  return 1
}

if ! _gw_run "moving ${src:t}" git -C "$main" worktree move "$src" "$dest"; then
  _gw_err "the branch is now $new; its worktree is still at $src"
  print -ru2 -- "  ${_GW_DIM}finish it with: git -C ${(q)main} worktree move ${(q)src} ${(q)dest}${_GW_RESET}"
  return 1
fi

_gw_prune_upto "$src" "$main"

# Follow it, if that is where we were standing.
[[ ${PWD:A} == ${src:A} || ${PWD:A} == ${src:A}/* ]] && cd -- "$dest"
_gw_info "$new is at $dest"
