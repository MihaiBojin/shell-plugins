# The root the worktrees of the repository containing $1 (default: $PWD) live
# under. Their full path is <root>/<NAME>/<REPO>.
#
# `.worktrees` beside the main checkout, and nothing configures it. Deriving it
# from the repository's own location means a fresh clone needs no setup to have
# somewhere sensible to put worktrees, and the companion `origin` plugin
# derives the same path the same way — two tools cannot disagree about a
# location neither of them can be told.
emulate -L zsh

local main
main=$(_gw_main_worktree "${1:-$PWD}") || return 1
print -r -- "${main:h}/.worktrees"
