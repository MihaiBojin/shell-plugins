# The worktrees of the current repository, formatted for a picker: three
# tab-separated fields, being branch (what fzf searches) \t the path, dimmed \t
# the raw path. The main checkout is included, marked `*` when you are in it.
# Fails when there is no repository to list.
#
# `git worktree list` is the whole source, by way of _gw_records: it finds this
# repository's worktrees wherever they sit, including ones created before the
# layout changed.
emulate -L zsh

# Declare every local up front: re-declaring one without a value makes zsh
# print it, which would land in the middle of the list.
local -a recs fields
local rec p br flags cwd mark short

_gw_in_repo || return 1

recs=( ${(f)"$(_gw_records)"} )
(( $#recs )) || return 1

cwd=${PWD:A}
for rec in $recs; do
  fields=( "${(@ps:\t:)rec}" )
  p=$fields[1]
  br=$fields[3]
  flags=$fields[4]
  if [[ -z $br ]]; then
    case $flags in
      *bare*)     br='(bare)' ;;
      *detached*) br='(detached)' ;;
      *)          br='?' ;;
    esac
  fi
  [[ $cwd == ${p:A} || $cwd == ${p:A}/* ]] && mark='*' || mark=' '
  short=$p
  [[ $short == $HOME/* ]] && short="~${short#$HOME}"
  print -r -- "$mark ${_GW_CYAN}${(r:30:)${br[1,30]}}${_GW_RESET}"$'\t'"${_GW_DIM}${short}${_GW_RESET}"$'\t'"$p"
done
