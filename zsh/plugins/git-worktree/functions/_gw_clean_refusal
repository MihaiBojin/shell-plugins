# Why worktree $1 must not be touched at all, into $REPLY — empty when there is
# no such reason. These are the refusals that have nothing to do with whether
# the branch was merged, and none of them is worked around.
#
#   $1 path  $2 branch  $3 flags  $4 $PWD resolved  $5 main worktree  $6 head branch
emulate -L zsh

local wt=$1 branch=$2 flags=$3 cwd=$4 main=$5 head=$6
REPLY=''

if [[ $cwd == ${wt:A} || $cwd == ${wt:A}/* ]]; then
  REPLY='is the worktree you are standing in'
  return 0
fi
if [[ -n $main && ${wt:A} == ${main:A} ]]; then
  REPLY='is the main worktree'
  return 0
fi
if [[ -z $branch ]]; then
  REPLY='has a detached HEAD'
  return 0
fi
if [[ $branch == "$head" ]]; then
  REPLY='is the head branch'
  return 0
fi
case $flags in
  *locked*)
    REPLY='is locked'
    return 0 ;;
  *prunable*)
    # Its directory is already gone; `git worktree prune` clears the
    # metadata, and the branch stays, which is the conservative half.
    REPLY='is stale — its directory is gone'
    return 0 ;;
esac

# Uncommitted changes and parked stashes, phrased once in one place because
# gwr refuses on exactly the same two.
_gw_work_in_progress "$wt" "$branch"
return 0
