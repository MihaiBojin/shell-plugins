# Usage, on stderr by default; `gw` asks for stdout so it can be piped.
emulate -L zsh
local fd=${1:-2}
local p

print -ru$fd -- "${_GW_BOLD}gw${_GW_RESET} — git worktree helpers"
print -ru$fd -- ""
print -ru$fd -- "  ${_GW_CYAN}gwl${_GW_RESET} [QUERY]              pick one of this repository's worktrees and cd into it"
print -ru$fd -- "  ${_GW_CYAN}gwa${_GW_RESET} NAME [BASE]          add a worktree for branch NAME (based on BASE), and cd into it"
print -ru$fd -- "      --fetch              also ask the remote whether NAME exists there already"
print -ru$fd -- "      --no-fetch           stay offline"
print -ru$fd -- "  ${_GW_CYAN}gwr${_GW_RESET} [PATH|QUERY]         remove a worktree whose branch is finished, and the branch"
print -ru$fd -- "      -f, --force          remove it even when it is not; the branch is kept"
print -ru$fd -- "      --no-forge           decide from git alone; never ask GitHub/GitLab"
print -ru$fd -- "      --all                do it to every finished worktree; a dry run without --yes"
print -ru$fd -- "        -y, --yes          go through with it"
print -ru$fd -- "        --branch NAME      consider only this branch"
print -ru$fd -- "  ${_GW_CYAN}gw${_GW_RESET},  ${_GW_CYAN}gwh${_GW_RESET}             this help"
print -ru$fd -- ""
print -ru$fd -- "worktrees live beside their repository, at"
print -ru$fd -- "  ${_GW_DIM}<PARENT>/.worktrees/<NAME>/<REPO>${_GW_RESET}"

# Where the repository you are standing in would put one.
if _gw_in_repo && p=$(_gw_dest NAME); then
  print -ru$fd -- "  here   ${${p/#$HOME/~}%/*}/${_GW_BOLD}${p:t}${_GW_RESET}"
else
  print -ru$fd -- "  ${_GW_DIM}(not in a git repository)${_GW_RESET}"
fi

print -ru$fd -- ""
print -ru$fd -- "${_GW_DIM}details: ${${_GW_DIR:-?}/#$HOME/~}/README.md${_GW_RESET}"
