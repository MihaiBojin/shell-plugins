# The sweep behind `gwr --all`: every worktree whose branch is finished goes,
# and the branch with it.
#
# The difference from a plain `gwr` is that nothing stops to ask per worktree,
# so this is a dry run until told twice — the dry run *is* the confirmation,
# listing what would go and what would not, with a reason for every line.
#
# A finished branch is deleted with its worktree, and the command that puts it
# back is printed for each one — that is the escape hatch, rather than a flag
# that keeps them. --force means one thing here and it is not this: remove a
# checkout that is not finished. The sweep never does that, at any scale.
#
# Nothing here asks an LLM anything. The judgement is three plain checks, in
# _gw_is_merged, and everything but the third works offline.
emulate -L zsh

integer yes=0 use_forge=1 dry=0
local only='' override=''

while (( $# )); do
  case $1 in
    -h|--help)     _gw_usage; return 0 ;;
    # --dry-run wins over --yes whichever order they arrive in: between two
    # flags that contradict each other, the one that removes nothing is the one
    # to obey. Fish's argparse settles it the same way.
    -y|--yes)      (( dry )) || yes=1; shift ;;
    -n|--dry-run)  dry=1; yes=0; shift ;;
    --no-forge)    use_forge=0; shift ;;
    --fetch)       override=always; shift ;;
    --no-fetch)    override=no; shift ;;
    --branch)
      [[ -n ${2-} ]] || { _gw_err "--branch needs a name"; return 2 }
      only=$2; shift 2 ;;
    --branch=*)    only=${1#--branch=}; shift ;;
    --)            shift; break ;;
    -*)            _gw_err "unknown option: $1"; return 2 ;;
    *)             _gw_err "gwr --all takes no positional arguments — did you mean: gwr --all --branch $1"; return 2 ;;
  esac
done
(( $# )) && { _gw_err "gwr --all takes no positional arguments — did you mean: gwr --all --branch $1"; return 2 }

_gw_in_repo || { _gw_err "not inside a git repository"; return 1 }

local main remote head_ref head_name cwd
main=$(_gw_main_worktree) || { _gw_err "cannot locate this repository's main worktree"; return 1 }
cwd=${PWD:A}
remote=$(_gw_remote -i "$main") || remote=''

# Same fetch policy as gwa: the comparison is only as good as how fresh the
# head branch is, and --no-fetch keeps the whole thing offline.
local mode
if [[ -n $override ]]; then
  mode=$override
else
  zstyle -s ':git-worktree:' fetch mode || mode=yes
fi
integer online=1
case $mode in
  no|false|off|0) online=0 ;;
esac

head_ref=$(_gw_default_branch "$remote" "$online" 1 "$main") || {
  _gw_err "cannot work out the default branch — there is nothing to compare against"
  return 1
}
head_name=$head_ref
[[ -n $remote && $head_ref == $remote/* ]] && head_name=${head_ref#$remote/}

if (( online )) && [[ -n $remote && $head_ref == $remote/* ]]; then
  _gw_run "fetching $head_ref" git fetch --quiet "$remote" "$head_name" ||
    _gw_warn "using the local copy of $head_ref"
fi

git rev-parse --verify --quiet "${head_ref}^{commit}" >/dev/null || {
  _gw_err "there is no $head_ref to compare against"
  return 1
}

# One call for the whole repository. It has to happen here, in this shell:
# inside $( ) the cache would be lost and every branch would pay for its own
# round trip. Offline, or without a forge CLI, the other two checks still work.
if (( online && use_forge )); then
  local kind
  if kind=$(_gw_forge_kind "$remote" "$main"); then
    _gw_forge_load "$kind" "$remote" "$main" || use_forge=0
  else
    use_forge=0
  fi
else
  use_forge=0
fi

local -a recs fields to_remove
local rec wt branch flags reason why verb REPLY
local US=$'\x1f'
integer skipped=0 considered=0

recs=( ${(0)"$(_gw_records)"} )
for rec in $recs; do
  fields=( "${(@ps:\x1f:)rec}" )
  wt=$fields[1] branch=$fields[3] flags=$fields[4]
  [[ $flags == *bare* ]] && continue
  [[ -n $only && $branch != "$only" ]] && continue
  (( considered++ ))

  _gw_clean_refusal "$wt" "$branch" "$flags" "$cwd" "$main" "$head_name"
  reason=$REPLY
  why=''
  if [[ -z $reason ]]; then
    if _gw_is_merged "$branch" "$head_ref" "$head_name" "$use_forge" "$main"; then
      why=$REPLY
    else
      reason=$REPLY
    fi
  fi

  # The verb is padded to a fixed width before it is coloured: (r:N:) counts
  # the escape bytes too, so colouring first would shift the column.
  if [[ -n $reason ]]; then
    (( skipped++ ))
    verb=skip
    print -ru2 -- "  ${_GW_DIM}${(r:13:)verb}${branch:-(detached)} — ${reason}${_GW_RESET}"
    continue
  fi

  to_remove+=( "$wt${US}${branch}${US}${why}" )
  if (( ! yes )); then
    verb='would remove'
    print -ru2 -- "  ${_GW_GREEN}${(r:13:)verb}${_GW_RESET}${_GW_CYAN}${branch}${_GW_RESET} — ${why}"
  fi
done

if (( ! considered )); then
  if [[ -n $only ]]; then
    _gw_err "no worktree of this repository has branch '$only' checked out"
    return 1
  fi
  _gw_info "no worktrees to consider"
  return 0
fi

if (( ! $#to_remove )); then
  _gw_info "nothing is finished; $skipped left alone"
  return 0
fi

if (( ! yes )); then
  _gw_info "$#to_remove to remove, $skipped left alone — re-run with --yes to do it"
  return 0
fi

integer removed=0 failed=0
for rec in $to_remove; do
  fields=( "${(@ps:\x1f:)rec}" )
  if _gw_remove_one "$fields[1]" "$fields[2]" "$fields[3]"; then
    (( removed++ ))
  else
    (( failed++ ))
  fi
done

git -C "$main" worktree prune 2>/dev/null

if (( failed )); then
  _gw_warn "removed $removed, left $skipped alone, $failed could not be removed"
  return 1
fi
_gw_info "removed $removed, left $skipped alone"
return 0
