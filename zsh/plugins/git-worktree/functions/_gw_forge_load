# Read every pull/merge request for the repository into _GW_FORGE_PRS, as
# "<branch>\t<STATE>\t<number>" lines, and name them in _GW_FORGE_NOUN.
#
#   $1 kind (github|gitlab)   $2 remote   $3 repository (default: $PWD)
#
# One call for the whole repository, never one per branch. It has to run in the
# caller's own shell for that to hold: assign it inside $( ) or a pipeline and
# the cache lands in a subshell, leaving every lookup to pay for its own round
# trip. Returns non-zero when there is nothing to read, which is not an error —
# every other check works offline.
#
# The repository is named to the CLI as OWNER/REPO rather than by path, since
# that is the only form -R takes; without it gh and glab answer about whatever
# repository the shell happens to be standing in, which for `gwr <path>` is the
# wrong one.
emulate -L zsh

local kind=$1 remote=$2 repo=${3:-$PWD} url slug REPLY
local -a scope

typeset -g _GW_FORGE_PRS=''
typeset -g _GW_FORGE_NOUN='pull request'

if slug=$(_gw_forge_slug "$remote" "$repo"); then
  scope=( -R "$slug" )
fi

# Fail closed. Without -R, gh and glab answer about whatever repository the
# shell happens to be standing in, and for `gwr <path>` that is somebody
# else's — an answer that then decides whether to delete a branch. No forge
# data at all is strictly better than another repository's.
(( $#scope )) || return 1

case $kind in
  github)
    (( $+commands[gh] )) || return 1
    gh auth status >/dev/null 2>&1 || return 1
    # gh carries its own jq, so --jq costs no extra dependency.
    _gw_run "reading this repository's pull requests" \
      gh "${scope[@]}" pr list --state all --limit 200 --json number,headRefName,state \
        --jq '.[] | [.headRefName, (.state | ascii_upcase), (.number | tostring)] | @tsv' || return 1
    _GW_FORGE_PRS=$REPLY
    ;;
  gitlab)
    _GW_FORGE_NOUN='merge request'
    (( $+commands[glab] && $+commands[jq] )) || return 1
    glab auth status >/dev/null 2>&1 || return 1
    _gw_run "reading this repository's merge requests" \
      glab "${scope[@]}" mr list --all --per-page 100 --output json || return 1
    _GW_FORGE_PRS=$(print -r -- "$REPLY" | jq -r \
      '.[] | [.source_branch, (.state | ascii_upcase | if . == "OPENED" then "OPEN" else . end), (.iid | tostring)] | @tsv' \
      2>/dev/null) || return 1
    ;;
  *) return 1 ;;
esac

[[ -n $_GW_FORGE_PRS ]]
