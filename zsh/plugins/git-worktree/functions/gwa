# gwa NAME [BASE] — add a worktree for branch NAME beside the repository, and
# cd into it.
emulate -L zsh

local override=''
local -a pos
while (( $# )); do
  case $1 in
    -h|--help)   _gw_usage; return 0 ;;
    --fetch)     override=always; shift ;;
    --no-fetch)  override=no; shift ;;
    --)          shift; pos+=( "$@" ); break ;;
    -*)          _gw_err "unknown option: $1"; return 2 ;;
    *)           pos+=( "$1" ); shift ;;
  esac
done

local name=${pos[1]} base=${pos[2]}
(( $#pos <= 2 )) || { _gw_err "too many arguments — usage: gwa NAME [BASE]"; return 2 }

_gw_in_repo || { _gw_err "not inside a git repository"; return 1 }

# No NAME: pick one. This is the set gwl cannot show — a branch that exists on
# the remote but has no worktree yet is invisible to a picker over worktrees.
if [[ -z $name ]]; then
  name=$(_gw_pick_branch 'branch>') || return $?
  [[ -n $name ]] || return 1
fi
git check-ref-format "refs/heads/$name" 2>/dev/null || {
  _gw_err "invalid branch name: $name"; return 2
}

local dest remote wtdir rec
local -a recs fields
# _gw_owns answers in $REPLY; without this it lands in the caller's shell.
local REPLY
dest=$(_gw_dest "$name") || { _gw_err "cannot locate this repository's main worktree"; return 1 }
wtdir=$(_gw_wt_dir)
remote=$(_gw_remote -i) || remote=''

if [[ -e $dest/.git ]]; then
  # Whose repository is it, before anything else? With the root derived from
  # the checkout's own parent, two repositories cannot normally reach the same
  # path — but a worktree made by hand, or a repository that moved, can already
  # be sitting there. The failure without this check is silent: `gwa auth`
  # reports "worktree already exists", exits 0, and cds you into somebody
  # else's checkout, where the next commit goes to the wrong repository.
  #
  # git answers this; `git worktree list` cannot. A squatter belongs to another
  # repository, so this one has never heard of it and the list comes back
  # empty — which reads exactly like "nothing is there".
  if ! _gw_owns "$dest"; then
    _gw_err "$dest is a worktree of ${REPLY}, not of this repository"
    _gw_err "move it, or pick a name that does not collide with it"
    return 1
  fi

  # Ours. Normally this is the same branch asked for twice; say whose it is
  # when it is not, rather than cd-ing somebody into a worktree they did not
  # ask for.
  local occupant=''
  recs=( ${(0)"$(_gw_records)"} )
  for rec in $recs; do
    fields=( "${(@ps:\x1f:)rec}" )
    [[ ${fields[1]:A} == ${dest:A} ]] || continue
    occupant=$fields[3]
    break
  done

  if [[ -z $occupant || $occupant == "$name" ]]; then
    _gw_info "worktree already exists: $dest"
    cd -- "$dest"
    return 0
  fi
  _gw_err "$dest is the worktree for '$occupant', not '$name'"
  return 1
fi

# Branch names nest, so one branch's worktree can be another's parent
# directory: branch `fix` in a repository called `login` occupies
# <root>/fix/login, which is exactly where branch `fix/login` puts its
# repositories. Neither can have it, and git's own message for either
# collision says only "already exists".
local ancestor=${dest:h} owner
while [[ -n $wtdir && $ancestor == $wtdir/* ]]; do
  if [[ -e $ancestor/.git ]]; then
    # Say whose, the same way the check above does: an ancestor can be another
    # branch's worktree of this repository, or another repository's entirely,
    # and what to do about it differs.
    if _gw_owns "$ancestor"; then
      owner=''
      recs=( ${(0)"$(_gw_records)"} )
      for rec in $recs; do
        fields=( "${(@ps:\x1f:)rec}" )
        [[ ${fields[1]:A} == ${ancestor:A} ]] || continue
        owner=$fields[3]
        break
      done
      _gw_err "$ancestor is this repository's worktree${owner:+ for '$owner'} — '$name' would nest inside it"
    else
      _gw_err "$ancestor is a worktree of ${REPLY} — '$name' would nest inside it"
    fi
    _gw_err "pick a branch name that is not a prefix of it, or move that worktree"
    return 1
  fi
  ancestor=${ancestor:h}
done

if [[ -d $dest ]]; then
  local -a squatters
  squatters=( $dest/*(ND) )
  if (( $#squatters )); then
    _gw_err "$dest already exists and is not empty — another branch is nesting under it"
    return 1
  fi
fi

local existing
if existing=$(_gw_worktree_of_branch "$name"); then
  _gw_info "branch '$name' is already checked out at $existing"
  cd -- "$existing"
  return 0
fi

# none: stay offline. base: refresh the branch we are about to fork from.
# full: also ask the remote whether NAME itself already exists.
local mode
if [[ -n $override ]]; then
  mode=$override
else
  zstyle -s ':git-worktree:' fetch mode || mode=yes
fi
case $mode in
  no|false|off|0) mode=none ;;
  always|all)     mode=full ;;
  *)              mode=base ;;
esac
local online=0
[[ $mode != none ]] && online=1

# Resolve what to branch off: a remote-tracking ref when there is one, so new
# branches start from what the remote has rather than a stale local copy.
local start
if [[ -n $base ]]; then
  if [[ -n $remote ]] && git show-ref --verify --quiet "refs/remotes/$remote/$base" 2>/dev/null; then
    start=$remote/$base
  elif git rev-parse --verify --quiet "${base}^{commit}" >/dev/null; then
    start=$base
  elif (( online )) && [[ -n $remote ]] &&
       _gw_run "fetching $remote/$base" git fetch --quiet "$remote" "$base"; then
    start=$remote/$base
    git show-ref --verify --quiet "refs/remotes/$remote/$base" 2>/dev/null || start=FETCH_HEAD
  else
    _gw_err "unknown base: $base"
    return 1
  fi
else
  start=$(_gw_default_branch "$remote" "$online" 1) || {
    _gw_err "cannot determine the default branch — pass BASE explicitly"
    return 1
  }
fi

if (( online )) && [[ -n $remote && $start == $remote/* ]]; then
  _gw_run "fetching $start" git fetch --quiet "$remote" "${start#$remote/}" ||
    _gw_warn "using the local copy of $start"
fi

# --fetch: NAME may exist on the remote without us knowing yet. Checking costs
# a round trip, so it is opt-in; skipping it would fork a second, divergent
# branch of the same name off the base.
if [[ $mode == full && -n $remote ]] &&
   ! git show-ref --verify --quiet "refs/heads/$name" 2>/dev/null &&
   ! git show-ref --verify --quiet "refs/remotes/$remote/$name" 2>/dev/null; then
  if _gw_remote_has_branch "$remote" "$name"; then
    _gw_info "$remote already has '$name' — tracking it instead of branching"
    _gw_run "fetching $remote/$name" git fetch --quiet "$remote" "$name" ||
      _gw_warn "could not fetch $remote/$name"
  fi
fi

# A .worktrees/ beside the repo is untracked junk if the parent is itself
# inside a working tree, and `git clean -xdff` there would delete it.
if [[ ! -d $wtdir ]] && git -C "${wtdir:h}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  _gw_warn "${wtdir:h} is inside a git working tree — add ${wtdir:t}/ to its .gitignore"
fi

mkdir -p -- "${dest:h}" || return 1

local label
local -a add
if git show-ref --verify --quiet "refs/heads/$name" 2>/dev/null; then
  label="checking out '$name'"
  add=( git worktree add "$dest" "$name" )
elif [[ -n $remote ]] && git show-ref --verify --quiet "refs/remotes/$remote/$name" 2>/dev/null; then
  label="checking out '$name' tracking $remote/$name"
  add=( git worktree add --track -b "$name" "$dest" "$remote/$name" )
else
  label="creating '$name' from $start"
  add=( git worktree add --no-track -b "$name" "$dest" "$start" )
fi

if ! _gw_run "$label" "${add[@]}"; then
  _gw_prune_upto "$dest" "$(_gw_main_worktree)"
  return 1
fi
_gw_info "$dest"

cd -- "$dest"
