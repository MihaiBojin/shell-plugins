# Prompt for a worktree; prints the selected path. $1 is the picker label,
# $2 an optional starting query.
emulate -L zsh

# NB: no local named `prompt` here — that one is a synonym for $PS1.
local label=${1:-worktree>} query=${2:-}
local -a lines

_gw_in_repo || { _gw_err "not inside a git repository"; return 1 }

lines=( ${(f)"$(_gw_list)"} )
# Inside a repository this is never empty: its own checkout is always listed.
if (( ! $#lines )); then
  _gw_err "no worktrees found"
  return 1
fi

local sel
if (( $+commands[fzf] )) && [[ -t 0 ]]; then
  local -a opts
  # Show the path but keep it out of the search: fuzzy-matching a long
  # absolute path makes every entry match nearly every query.
  opts=(
    --ansi --height=50% --layout=reverse --border --tabstop=1
    --prompt="$label " --delimiter=$'\t' --with-nth=1,2 --nth=1
    --color='hl:#ffcc00,info:#00ffcc,prompt:#ff00ff,pointer:#ff3300'
    --preview='git -C {-1} -c color.ui=always status --short --branch; echo; git -C {-1} -c color.ui=always log --oneline --decorate -15'
    --preview-window='down:12:wrap'
  )
  [[ -n $query ]] && opts+=( --query="$query" --select-1 --exit-0 )
  sel=$(print -rl -- "${lines[@]}" | fzf "${opts[@]}") || return 1
else
  # Without fzf the QUERY still narrows, and still narrows on the branch alone:
  # field 1 is `<mark> <branch>` with colour in it, and matching the whole line
  # would put the path back in the search that --nth=1 keeps it out of.
  setopt localoptions extended_glob
  local -a shown
  local i branch
  for (( i = 1; i <= $#lines; i++ )); do
    branch=${${${${lines[i]%%$'\t'*}//$'\e'\[[0-9;]#m/}##[* ] #}%% #}
    [[ -z $query || $branch == *$query* ]] && shown+=( $i )
  done
  if (( ! $#shown )); then
    _gw_err "nothing matches: $query"
    return 1
  fi
  # One match and a query to have found it: the same --select-1 fzf is given.
  if (( $#shown == 1 && $#query )); then
    print -r -- "${lines[shown[1]]##*$'\t'}"
    return 0
  fi
  local n
  for (( n = 1; n <= $#shown; n++ )); do
    print -ru2 -- "${(l:3:)n}) ${${lines[shown[n]]%$'\t'*}//$'\t'/ }"
  done
  # Not read's ?prompt: it only appears in an interactive shell, and this
  # runs inside $( ). Same shape as _gw_choose.
  local ans
  print -ru2 -n -- "Selection (1-$#shown): "
  read ans || { print -ru2 -- ""; return 1 }
  [[ $ans == <-> ]] && (( ans >= 1 && ans <= $#shown )) || { _gw_err "invalid selection"; return 1 }
  sel=${lines[shown[ans]]}
fi

[[ -n $sel ]] || return 1
print -r -- "${sel##*$'\t'}"
