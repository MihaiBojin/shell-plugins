# The OWNER/REPO the forge knows remote $1 of the repository at $2 by, or
# nothing and a non-zero status when there is no such name.
#
# gh and glab take -R OWNER/REPO and nothing else — not a path — and without it
# they answer about whatever repository the shell is standing in, which for
# `gwr <path>` is somebody else's. So this has to succeed for the forge to be
# asked at all.
#
# GitLab subgroups nest to any depth and glab documents -R GROUP/NAMESPACE/REPO,
# so more than one slash is still a name; only an absolute path is a path.
emulate -L zsh

local remote=$1 repo=${2:-$PWD} url slug

[[ -n $remote ]] || return 1
url=$(git -C "$repo" remote get-url "$remote" 2>/dev/null) || return 1
[[ -n $url ]] || return 1

slug=${${url#*://*/}#*:}
slug=${slug%.git}
slug=${slug%/}

[[ $slug == */* && $slug != /* ]] || return 1
print -r -- "$slug"
