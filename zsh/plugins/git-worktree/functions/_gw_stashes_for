# How many stash entries were recorded while branch $1 was checked out, in
# the repository at $2 (default: $PWD).
#
# The repository has to be named: gwr is given a path and can be standing
# anywhere, and `git stash list` in the wrong repository answers about the
# wrong stashes — or fails and answers zero, which reads as "nothing parked".
#
# Compared case-insensitively by lowercasing both sides rather than by pattern:
# git writes "WIP on <branch>:" for a plain stash and "On <branch>:" for one
# given a message, and a branch name is not a glob.
emulate -L zsh

local branch=${1:l} repo=${2:-$PWD} line
integer n=0
while IFS= read -r line; do
  [[ ${line:l} == *"on ${branch}:"* ]] && (( n++ ))
done < <(git -C "$repo" stash list 2>/dev/null)
print -r -- $n
