# Work in worktree $1 on branch $2 that removing the checkout would interrupt,
# into $REPLY — empty when there is none.
#
# Shared by gwr and the sweep so both say the same thing about the same state.
# Neither of these is lost by removing a worktree, strictly: uncommitted
# changes are, but a stash lives in the repository's own refs and survives.
# Both mean the same thing though — somebody is still working here.
emulate -L zsh

local wt=$1 branch=$2 dirty
integer stashes
REPLY=''

dirty=$(git -C "$wt" status --porcelain 2>/dev/null)
if [[ -n $dirty ]]; then
  # --porcelain counts untracked files and ignores gitignored ones, which is
  # exactly the set that makes `git worktree remove` refuse.
  REPLY='has uncommitted changes'
  return 0
fi

[[ -n $branch ]] || return 0

stashes=$(_gw_stashes_for "$branch" "$wt")
if (( stashes == 1 )); then
  REPLY='has a stash entry parked on it'
elif (( stashes > 1 )); then
  REPLY="has $stashes stash entries parked on it"
fi
return 0
