# gwr [PATH|QUERY] — remove a worktree whose branch is finished, and delete the
# branch with it. One worktree, named or picked; `origin prune` is what asks the
# same question of every worktree at once.
#
# Every question below is asked of $main, the repository the *target* belongs
# to, never of $PWD. An explicit path works from anywhere, and answering "is
# this branch finished?" in the shell's own repository is how an unmerged
# branch in another one gets deleted. A branch that is not safe to delete
# is work in progress, and this is where that work lives — so an unmerged
# worktree is refused outright rather than removed with its branch left behind.
#
# --force overrides the refusals, never the branch: forcing past an unmerged
# worktree removes the checkout and keeps the branch, which is recoverable —
# `gwa NAME` brings it back. Deleting a branch stays automatic and happens only
# when the predicate proved it merged; the sha and the command that puts it
# back are printed, so that is recoverable with one paste too.
emulate -L zsh

local -a force pos
integer use_forge=1 forced=0 delete_ignored=0
while (( $# )); do
  case $1 in
    -h|--help)        _gw_usage; return 0 ;;
    -f|--force)       forced=1; force=( --force ); shift ;;
    # Its own flag, not part of --force. --force permits removing a checkout
    # whose branch is unfinished, which is recoverable — the branch stays and
    # `gwa NAME` brings the checkout back. This permits deleting files no ref
    # has ever pointed at, which nothing brings back.
    --delete-ignored) delete_ignored=1; shift ;;
    --no-forge)       use_forge=0; shift ;;
    # The sweep left. Naming its flags rather than letting them fall into
    # "unknown option" is the difference between a reader who knows where it
    # went and one who thinks it was never there.
    --all|-y|--yes|-n|--dry-run|--branch|--fetch|--no-fetch)
                      _gw_err "$1 belonged to the sweep; that is 'origin prune' now"; return 2 ;;
    --)               shift; pos+=( "$@" ); break ;;
    -*)               _gw_err "unknown option: $1"; return 2 ;;
    *)                pos+=( "$1" ); shift ;;
  esac
done

(( $#pos <= 1 )) || { _gw_err "too many arguments — usage: gwr [PATH|QUERY]"; return 2 }

# An explicit path works from anywhere; the picker needs a repository.
local target=$pos[1] dest
if [[ -n $target && -d $target ]]; then
  dest=${target:a}
else
  dest=$(_gw_pick 'remove worktree>' "$target") || return 1
fi

[[ -d $dest ]] || { _gw_err "no such directory: $dest"; return 1 }
git -C "$dest" rev-parse --git-dir >/dev/null 2>&1 || {
  _gw_err "not a git worktree: $dest"; return 1
}

local main
main=$(_gw_main_worktree "$dest") || {
  _gw_err "cannot locate the main worktree for $dest"; return 1
}
if [[ ${dest:A} == ${main:A} ]]; then
  _gw_err "refusing to remove the main worktree: $dest"
  return 1
fi

# One `git worktree list` for the branch and the flags both.
local -a recs fields
local rec branch='' flags='' sha=''
local REPLY
recs=( ${(0)"$(_gw_records "$main")"} )
for rec in $recs; do
  fields=( "${(@ps:\x1f:)rec}" )
  [[ ${fields[1]:A} == ${dest:A} ]] || continue
  sha=$fields[2]
  branch=$fields[3]
  flags=$fields[4]
  break
done

# Locked is the one refusal --force does not cover: you locked it deliberately,
# and git itself wants --force twice. Unlock it and mean it.
if [[ $flags == *locked* ]]; then
  _gw_err "$dest is locked — unlock it first: git -C ${(q)main} worktree unlock ${(q)dest}"
  return 1
fi

# Is this worktree finished with? Answered before the prompt, so the prompt can
# say. Offline except for the forge, and never interactive: gwr must not stop
# to ask which remote it is on when it is already asking whether to proceed.
local reason='' why='' remote head_ref head_name
integer delete_branch=0

_gw_work_in_progress "$dest" "$branch"
reason=$REPLY

if [[ -z $reason ]]; then
  if [[ -z $branch ]]; then
    reason='has a detached HEAD — there is no branch to prove finished'
  else
    remote=$(_gw_remote "$main" 2>/dev/null) || remote=''
    head_ref=$(_gw_default_branch "$remote" 0 0 "$main" 2>/dev/null) || head_ref=''
    if [[ -z $head_ref ]]; then
      reason='there is no head branch to compare it against'
    else
      # The ref is what the merge questions are asked about; the name is what
      # the messages say and what "is it the head branch?" compares against.
      head_name=${head_ref#refs/remotes/}
      head_name=${head_name#refs/heads/}
      [[ -n $remote && $head_name == $remote/* ]] && head_name=${head_name#$remote/}
      if (( use_forge )); then
        local kind
        if kind=$(_gw_forge_kind "$remote" "$main"); then
          _gw_forge_load "$kind" "$remote" "$main" || use_forge=0
        else
          use_forge=0
        fi
      fi
      if _gw_is_merged "$branch" "$head_ref" "$head_name" "$use_forge" "$main"; then
        why=$REPLY
        # A worktree can have the head branch checked out, and the head branch
        # is an ancestor of itself. Removing that checkout is fine; deleting
        # main is never what was meant.
        if [[ $branch == "$head_name" ]]; then
          why="$why, and it is the head branch"
        else
          delete_branch=1
        fi
      else
        reason=$REPLY
      fi
    fi
  fi
fi

if [[ -n $reason ]] && (( ! forced )); then
  _gw_err "not removing $dest"
  print -ru2 -- "  ${branch:+branch ${_GW_CYAN}${branch}${_GW_RESET} — }${reason}"
  print -ru2 -- "  ${_GW_DIM}the checkout is where unfinished work lives; remove it anyway with:${_GW_RESET}"
  print -ru2 -- "  ${_GW_DIM}  gwr --force ${(q)dest}${branch:+   (the branch is kept)}${_GW_RESET}"
  # Nothing keeps a detached HEAD's commits once the worktree goes: there is no
  # branch to survive it, and the advice above would be a promise this cannot
  # make. Give the sha, which is the only thing that brings them back.
  [[ -n $branch || -z $sha ]] ||
    print -ru2 -- "  ${_GW_DIM}  nothing will refer to ${sha[1,7]} afterwards; keep it first with:${_GW_RESET}"
  [[ -n $branch || -z $sha ]] ||
    print -ru2 -- "  ${_GW_DIM}    git -C ${(q)main} branch NAME ${sha}${_GW_RESET}"
  return 1
fi

# `git worktree remove --force` walks past git's own submodule refusal and
# deletes .git/worktrees/<id>/modules/* with the checkout — the submodule's
# only copy of anything committed there, which nothing brings back and fsck
# does not notice. Refuse rather than advertise it.
local gitdir
if (( forced )) && gitdir=$(git -C "$dest" rev-parse --absolute-git-dir 2>/dev/null) &&
   [[ -d $gitdir/modules ]]; then
  _gw_err "$dest holds submodule git directories — --force would delete them with it"
  print -ru2 -- "  ${_GW_DIM}push the submodules' commits somewhere first, then:${_GW_RESET}"
  print -ru2 -- "  ${_GW_DIM}  git -C ${(q)main} worktree remove --force ${(q)dest}${_GW_RESET}"
  return 1
fi

# Gitignored files are the one loss nothing here can undo. `git worktree
# remove` deletes them without --force and without a word, and every refusal
# above read this checkout as clean because `git status --porcelain` does not
# report them. So they are listed before the question, and the question is
# asked even when everything else about the removal is routine.
local -a ignored
local ign_word ign_them p
integer n_ignored=0
if (( ! delete_ignored )); then
  ignored=( ${(f)"$(_gw_ignored_paths "$dest")"} )
  n_ignored=$#ignored
fi
ign_word="ignored paths"; ign_them=them
(( n_ignored == 1 )) && { ign_word="ignored path"; ign_them=it }

# No terminal is not a licence to guess. --yes would not answer this either:
# it means "do not ask about anything git could put back", and this is the one
# thing it could not.
if (( n_ignored )) && [[ ! -t 0 ]]; then
  _gw_err "not removing $dest — it holds $n_ignored $ign_word and there is no terminal to ask on"
  for p in $ignored; do print -ru2 -- "      $p"; done
  print -ru2 -- "  ${_GW_DIM}nothing tracks ${ign_them} and nothing restores ${ign_them}; pass --delete-ignored if you mean it${_GW_RESET}"
  return 1
fi

print -ru2 -- "Remove worktree ${_GW_BOLD}${dest}${_GW_RESET}"
if (( delete_branch )); then
  print -ru2 -- "  branch ${_GW_CYAN}${branch}${_GW_RESET} — ${why}; ${_GW_BOLD}it will be deleted${_GW_RESET}"
elif [[ -n $branch ]]; then
  print -ru2 -- "  branch ${_GW_CYAN}${branch}${_GW_RESET} — ${reason:-${why:-nothing to report}}; it is kept"
fi
(( forced )) && [[ -n $reason ]] &&
  print -ru2 -- "  ${_GW_RED}--force: removing it anyway${_GW_RESET}"
if (( n_ignored )); then
  print -ru2 -- "  ${_GW_RED}${n_ignored} ${ign_word}${_GW_RESET} — nothing tracks ${ign_them}, and nothing restores ${ign_them}:"
  for p in $ignored; do print -ru2 -- "      $p"; done
fi

local rc=0
local question="Proceed?"
(( n_ignored )) &&
  question="Delete ${n_ignored} ${ign_word} along with the worktree?"
if _gw_confirm "$question"; then
  # Step out before deleting the directory we may be standing in.
  local cwd=${PWD:A}
  [[ $cwd == ${dest:A} || $cwd == ${dest:A}/* ]] && cd -- "$main"

  if _gw_run "removing ${dest:t}" git -C "$main" worktree remove "${force[@]}" "$dest"; then
    _gw_prune_upto "$dest" "$main"
    # The branch path prints its own way back further down; a detached one has
    # no branch, so this is the only line that can.
    [[ -n $branch || -z $sha ]] ||
      print -ru2 -- "    restore: git -C ${(q)main} branch NAME ${sha}"
    if (( delete_branch )); then
      # Read the sha before the delete: afterwards there is no name left to
      # resolve it from, and parsing it back out of `git branch -d`'s own
      # output is worse than having read it a moment earlier.
      local was
      was=$(git -C "$main" rev-parse --short "refs/heads/$branch" 2>/dev/null) || was=''

      # -D is reached only when the predicate already said the change is
      # upstream: `git branch -d` refuses a squash-merged branch on principle,
      # because from where git stands it is unmerged. It is not a fallback for
      # a branch that failed the check — that branch never gets here, with or
      # without --force.
      if git -C "$main" branch -d "$branch" >/dev/null 2>&1 ||
         git -C "$main" branch -D "$branch" >/dev/null 2>&1; then
        _gw_info "deleted branch ${branch}${was:+ (was ${was})} — ${why}"
        # There is no --keep-branch, so this is the way back: one line, one
        # paste, printed for the branch it belongs to.
        [[ -n $was ]] &&
          print -ru2 -- "    restore: git branch ${(q-)branch} ${was}"
      else
        _gw_warn "removed the worktree but could not delete ${branch}"
      fi
    fi
  else
    rc=$?
    if (( ! forced )); then
      if [[ $REPLY == *submodule* ]]; then
        _gw_warn "still there — it holds submodules, and --force would delete their git directories along with it"
      else
        _gw_warn "still there — retry with: gwr --force ${(q)dest}"
      fi
    fi
  fi
else
  _gw_info "aborted"
  rc=1
fi

_gw_suggest_prune "$main"
return $rc
