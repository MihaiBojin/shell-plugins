# The worktree that has branch $1 checked out, if any.
#
# -z for the same reason _gw_records uses it: a worktree whose directory name
# contains a newline arrives as two lines otherwise, and the path handed back
# is the truncated first half — which gwa then cds into.
emulate -L zsh

local out attr wt=''
out=$(git worktree list --porcelain -z 2>/dev/null) || return 1
for attr in ${(ps:\0:)out}; do
  case $attr in
    'worktree '*)           wt=${attr#worktree } ;;
    "branch refs/heads/$1") [[ -n $wt ]] && { print -r -- "$wt"; return 0 } ;;
  esac
done
return 1
