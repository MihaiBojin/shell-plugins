# Remove worktree $1 and delete its branch $2, having established elsewhere
# that the branch is finished. $3 is the reason, shown in the progress line.
#
# Order matters: the worktree goes first, because git will not delete a branch
# that is checked out somewhere.
emulate -L zsh

local wt=$1 branch=$2 why=$3 main dirty was

main=$(_gw_main_worktree "$wt") || main=$(_gw_main_worktree) || {
  _gw_err "cannot locate the main worktree for $wt"
  return 1
}

# No --force here, ever. `git worktree remove` refuses a worktree holding
# modified or untracked files, and `git status --porcelain` — which is what
# _gw_clean_refusal asked — flags exactly the same set, gitignored files
# excluded on both sides. So a refusal at this point means something appeared
# since that check, and forcing past it would delete work nobody has seen.
# `gwr --force` is the deliberate way to do that.
if ! _gw_run "removing ${branch} — ${why}" git -C "$main" worktree remove "$wt"; then
  dirty=$(git -C "$wt" status --porcelain 2>/dev/null)
  if [[ -n $dirty ]]; then
    _gw_warn "$wt has work in it after all; leaving it"
    return 1
  fi
  if [[ $REPLY == *submodule* ]]; then
    _gw_warn "left $wt alone; it holds submodules, and --force would delete their git directories"
  else
    _gw_warn "left $wt alone; remove it deliberately with: gwr --force ${(q)wt}"
  fi
  return 1
fi

_gw_prune_upto "$wt" "$main"

# Read the sha before the delete: afterwards there is no name left to resolve
# it from, and parsing it back out of `git branch -d`'s own output is worse
# than having read it a moment earlier.
was=$(git -C "$main" rev-parse --short "refs/heads/$branch" 2>/dev/null) || was=''

# -d first, then -D. `git branch -d` refuses a squash-merged branch on
# principle, because from where git stands it is unmerged — and check 2 of the
# predicate is precisely the proof that it is not. A branch that failed the
# checks never reaches this function, so -D here is never a guess.
if git -C "$main" branch -d "$branch" >/dev/null 2>&1 ||
   git -C "$main" branch -D "$branch" >/dev/null 2>&1; then
  _gw_info "deleted branch ${branch}${was:+ (was ${was})}"
  # Printed per branch rather than once per run, so the way back to any one of
  # them can be copied on its own. This is the whole escape hatch: there is no
  # flag that keeps a finished branch.
  [[ -n $was ]] &&
    print -ru2 -- "    restore: git branch ${(q-)branch} ${was}"
  return 0
fi

_gw_warn "removed the worktree but could not delete ${branch}"
return 0
