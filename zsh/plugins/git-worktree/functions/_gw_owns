# Does this repository own the worktree at $1? Returns 0 when it does or when
# there is no repository there at all; returns 1 and puts the owning
# repository's path in $REPLY when somebody else does.
#
# git is what answers this. `git worktree list` cannot: a worktree belonging to
# another repository is one this repository has never heard of, so the list
# comes back empty and reads exactly like "nothing is there" — which is how a
# `gwa` that should have refused ends up cd-ing you into somebody else's
# checkout instead.
emulate -L zsh

local candidate=$1 theirs ours
REPLY=''

theirs=$(git -C "$candidate" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
[[ -n $theirs ]] || return 0

# No -C: gwa runs inside the repository, and from a worktree of it this still
# resolves to the repository's own common dir, which is the point.
ours=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
[[ -n $ours ]] || return 0

[[ ${theirs:A} == ${ours:A} ]] && return 0

REPLY=${${theirs:A}:h}
return 1
