# Run "$@" behind a spinner labelled $1. Its output (stdout and stderr merged)
# lands in $REPLY and is shown only when the command fails; the exit status is
# passed through. Without a terminal nothing animates — just the result line.
#
# Anything that can reach the network gets one of these, so a slow fetch looks
# like work rather than a hang. Everything is written to stderr: these helpers
# run inside $( ) whose stdout is the caller's return value.
emulate -L zsh
# no_monitor turns job control off, which is what keeps the backgrounded
# command below from announcing itself as "[1] 12345". Deliberately *not*
# no_notify as well: with a background job in scope, that combination loses the
# caller's stdout when this runs as the last element of a pipeline with a
# redirection — `print y | gwr --force PATH >/dev/null` silently kills every
# later `print` in the calling script. no_monitor alone is silent anyway, in an
# interactive shell too.
setopt local_options no_monitor

# zselect lets the spinner sleep without forking. Loaded on first use rather
# than at plugin load, so a shell that never runs a worktree command never
# pays for it.
zmodload -F zsh/zselect b:zselect 2>/dev/null

local msg=$1; shift
local tmp rc pid i=0 hint=''

# `spinner no` turns off the animation, not the result line — so the icons
# still follow the locale rather than the animation setting.
local style animate=1 charset=ascii
zstyle -s ':git-worktree:' spinner style || style=yes
[[ ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} == *(UTF-8|utf8|UTF8) ]] && charset=unicode
[[ $style == no ]] && animate=0
[[ $style == ascii ]] && charset=ascii

local -a frames
local tick cross
if [[ $charset == unicode ]]; then
  frames=( ⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏ ); tick=✓; cross=✗
else
  frames=( '|' '/' '-' '\' ); tick='+'; cross='!'
fi

# Without a temporary file there is no spinner, but REPLY still has to be
# the command's output: callers read it as the answer, and an unset one
# reads as "the remote does not have that branch".
tmp=$(mktemp "${TMPDIR:-/tmp}/gw.XXXXXX") || {
  REPLY=$("$@" 2>&1)
  return $?
}

"$@" >|"$tmp" 2>&1 &
pid=$!

if (( animate )) && [[ -t 2 ]]; then
  # Restore the cursor even if the user interrupts mid-spin. LOCAL_TRAPS
  # (implied by emulate -L) puts the previous handler back on return.
  trap 'printf "\r\e[2K\e[?25h" >&2' INT
  _gw_nap 12                                   # no flicker for fast commands
  if kill -0 $pid 2>/dev/null; then
    printf '\e[?25l' >&2
    while kill -0 $pid 2>/dev/null; do
      printf '\r\e[2K%s[%s]%s %s%s' "$_GW_CYAN" "${frames[i % $#frames + 1]}" "$_GW_RESET" "$msg" "$hint" >&2
      _gw_nap 8
      # Git's own prompts (a passphrase, HTTPS credentials) are captured along
      # with the rest of its output, so a wait for input looks like a hang.
      (( ++i == 120 )) && hint=" ${_GW_DIM}(still waiting — ^C to cancel)${_GW_RESET}"
    done
    printf '\r\e[2K\e[?25h' >&2
  fi
fi

wait $pid
rc=$?
REPLY=$(<"$tmp")
rm -f "$tmp"

if (( rc == 0 )); then
  print -ru2 -- "${_GW_GREEN}[$tick]${_GW_RESET} ${_GW_DIM}${msg}${_GW_RESET}"
else
  print -ru2 -- "${_GW_RED}[$cross]${_GW_RESET} ${msg}"
  local l
  for l in ${(f)REPLY}; do print -ru2 -- "    ${_GW_DIM}${l}${_GW_RESET}"; done
fi
return $rc
