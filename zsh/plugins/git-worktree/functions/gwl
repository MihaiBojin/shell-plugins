# gwl [QUERY] — pick one of this repository's worktrees and cd into it.
#
# --list prints them instead, which is the only way to see the set without
# moving into one of them, and the only form that can be piped.
emulate -L zsh

local -a pos
integer listing=0
while (( $# )); do
  case $1 in
    -h|--help) _gw_usage; return 0 ;;
    -l|--list) listing=1; shift ;;
    --)        shift; pos+=( "$@" ); break ;;
    -*)        _gw_err "unknown option: $1"; return 2 ;;
    *)         pos+=( "$1" ); shift ;;
  esac
done

(( $#pos <= 1 )) || { _gw_err "too many arguments — usage: gwl [QUERY]"; return 2 }

if (( listing )); then
  (( ! $#pos )) || { _gw_err "gwl --list takes no QUERY"; return 2 }
  _gw_in_repo || { _gw_err "not inside a git repository"; return 1 }
  _gw_plain_list
  return $?
fi

local dest
dest=$(_gw_pick 'worktree>' "$pos[1]") || return 1
[[ -d $dest ]] || { _gw_err "no such directory: $dest"; return 1 }
cd -- "$dest"
