# Download the zip at $1 and unpack application $2 into /Applications.
#
#   install_app_zip https://example.com/thing.zip Thing
emulate -L zsh

(( $# >= 2 )) || {
  print -ru2 -- "usage: install_app_zip URL APP_NAME"
  return 2
}

local url=$1 app=$2 dir tmp
# The download goes inside a directory mktemp created, not next to it:
# `$(mktemp -t x).pkg` leaves the file mktemp actually made lying around and
# writes to a path nothing created safely — which then goes to `sudo` as root,
# on a /tmp anyone can write to.
dir=$(mktemp -d -t install_app_zip) || return 1
tmp=$dir/download.zip
trap "rm -rf ${(q)dir}" EXIT INT TERM

print -r -- "Installing $app"
curl -fLo "$tmp" "$url" || return 1
# -d rather than cd: unzipping used to leave the caller standing in
# /Applications.
sudo unzip "$tmp" -d /Applications
