# Pin the application $1 to the Dock. Takes effect on `killall Dock`.
#
#   _add_dock_persistent_app /Applications/Ghostty
#
# The name is given without the .app suffix, as `defaults` wants it appended to
# a file:// URL rather than a path.
emulate -L zsh

[[ -n ${1-} ]] || {
  print -ru2 -- "usage: _add_dock_persistent_app APP_PATH_WITHOUT_SUFFIX"
  return 2
}

local app=$1
[[ -e $app.app ]] || return 0

print -r -- "Adding $app to persistent apps"
defaults write com.apple.dock persistent-apps -array-add \
  "<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key><string>${app}.app/</string><key>_CFURLStringType</key><integer>0</integer></dict></dict></dict>"
